        "type": "VARCHAR(10)",
        "flags": [
          "NN"
        ],
        "default": "'MEDIUM'",
        "note": ""
      },
      {
        "name": "record_state",
        "type": "VARCHAR(10)",
        "flags": [
          "NN"
        ],
        "default": "'DRAFT'",
        "note": "Form completion state, separate from case workflow"
      },
      {
        "name": "notes",
        "type": "TEXT",
        "flags": [],
        "default": null,
        "note": ""
      },
      {
        "name": "created_at",
        "type": "DATETIME(6)",
        "flags": [
          "NN"
        ],
        "default": "CURRENT_TIMESTAMP(6)",
        "note": "UTC timestamp"
      },
      {
        "name": "updated_at",
        "type": "DATETIME(6)",
        "flags": [
          "NN"
        ],
        "default": "CURRENT_TIMESTAMP(6)",
        "note": "Maintained by BEFORE UPDATE trigger; UTC"
      }
    ],
    "checks": [
      "case_status IN ('OPEN','UNDER_REVIEW','FOLLOW_UP','CLOSED')",
      "priority IN ('LOW','MEDIUM','HIGH','URGENT')",
      "record_state IN ('DRAFT','SUBMITTED')",
      "record_state = 'DRAFT' OR CHAR_LENGTH(TRIM(chief_complaint)) > 0",
      "record_state <> 'DRAFT' OR case_status = 'OPEN'"
    ],
    "notes": "A DRAFT may have zero visits. Submitting requires at least one initial visit in the same transaction. Case doctor is current assignee; visit doctor is the actual attending doctor."
  },
